<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="data:,">
  <title>netcheck network dashboard</title>
  <style>
    :root {
      --bg: #f4f1ea;
      --card: #fffdf8;
      --ink: #1f2937;
      --muted: #6b7280;
      --line: #d9d3c7;
      --accent: #264653;
      --accent-soft: #dbe7ea;
      --danger: #d65d47;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at top right, rgba(231,111,81,0.18), transparent 20%),
        radial-gradient(circle at left top, rgba(38,70,83,0.12), transparent 25%),
        var(--bg);
    }
    .page {
      max-width: 1360px;
      margin: 0 auto;
      padding: 28px 20px 48px;
    }
    .hero {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      align-items: end;
      margin-bottom: 18px;
    }
    .hero h1 {
      margin: 0;
      font-size: 34px;
      letter-spacing: 0.02em;
    }
    .hero p {
      margin: 8px 0 0;
      color: var(--muted);
    }
    .toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      margin-bottom: 18px;
      padding: 14px;
      background: rgba(255,253,248,0.9);
      border: 1px solid rgba(0,0,0,0.05);
      border-radius: 18px;
      box-shadow: 0 12px 40px rgba(31,41,55,0.06);
    }
    .toolbar strong {
      margin-right: 4px;
    }
    .preset-group {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      flex: 1 1 auto;
    }
    .custom-range-group {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      flex: 0 0 auto;
      margin-left: auto;
    }
    .toolbar button, .toolbar input {
      border: 1px solid rgba(38,70,83,0.18);
      border-radius: 10px;
      background: white;
      color: var(--ink);
      padding: 8px 12px;
      font: inherit;
      white-space: nowrap;
    }
    .toolbar input {
      min-width: 188px;
    }
    .toolbar button {
      cursor: pointer;
    }
    .toolbar button.active {
      background: var(--accent);
      color: white;
      border-color: var(--accent);
    }
    .toolbar .muted {
      color: var(--muted);
      font-size: 13px;
    }
    .language-switch {
      display: inline-flex;
      gap: 4px;
      padding: 3px;
      border: 1px solid rgba(38,70,83,0.18);
      border-radius: 12px;
      background: rgba(255,255,255,0.7);
    }
    .language-switch button {
      border: 0;
      border-radius: 9px;
      padding: 6px 10px;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font: inherit;
      font-size: 13px;
    }
    .language-switch button.active {
      background: var(--accent);
      color: white;
    }
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 390px), 1fr));
      gap: 14px;
      margin-bottom: 20px;
    }
    .card, .panel {
      background: var(--card);
      border: 1px solid rgba(0,0,0,0.05);
      border-radius: 18px;
      box-shadow: 0 12px 40px rgba(31,41,55,0.06);
    }
    .card {
      padding: 16px;
    }
    .card h2 {
      margin: 0 0 12px;
      font-size: 18px;
    }
    .metric-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 148px), 1fr)); gap: 12px 16px; }
    .metric-entry { min-width: 0; }
    .metric-label { color: var(--ink); font-size: 13px; font-weight: 600; margin-bottom: 6px; line-height: 1.25; }
    .metric-stack { display: grid; gap: 4px; min-width: 0; }
    .metric-row { display: inline-flex; flex-wrap: nowrap; align-items: center; gap: 6px; max-width: 100%; min-width: 0; }
    .metric-value { font-size: 15px; font-weight: 700; min-width: 0; line-height: 1.2; white-space: nowrap; }
    .metric-tag { display: inline-flex; align-items: center; flex: 0 0 auto; padding: 2px 6px; border-radius: 999px; background: rgba(38,70,83,0.08); color: var(--muted); font-size: 10px; line-height: 1.2; white-space: nowrap; }
    .meta { display: grid; grid-template-columns: 220px 1fr; gap: 14px; margin-bottom: 20px; }
    .panel { padding: 16px; }
    .panel h3 { margin: 0 0 10px; font-size: 18px; }
    .dimension { margin-bottom: 20px; }
    .dimension h2 { margin: 0 0 10px; font-size: 20px; }
    .dimension-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
    .codex-section { margin-bottom: 20px; }
    .codex-title-row {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: baseline;
      margin: 0 0 10px;
    }
    .codex-title-row h2 { margin: 0; font-size: 20px; }
    .codex-title-row span { color: var(--muted); font-size: 13px; }
    .codex-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(132px, 1fr));
      gap: 14px;
      margin-bottom: 14px;
    }
    .codex-metric { min-height: 92px; }
    .codex-hint {
      margin-top: 8px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.35;
    }
    .codex-chart { margin-bottom: 14px; }
    .chart.codex-chart svg { height: 240px; }
    .chart {
      position: relative;
      padding: 14px;
    }
    .chart-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 10px;
    }
    .chart-header h3 {
      margin: 0;
      font-size: 16px;
    }
    .chart-header span {
      font-size: 12px;
      color: var(--muted);
    }
    .chart svg {
      width: 100%;
      height: 220px;
      display: block;
      border-radius: 12px;
      background: linear-gradient(180deg, rgba(255,255,255,0.85), rgba(244,241,234,0.35));
    }
    .chart-tooltip {
      position: absolute;
      left: 0;
      top: 0;
      z-index: 2;
      min-width: 140px;
      padding: 8px 10px;
      border-radius: 10px;
      background: rgba(31,41,55,0.92);
      color: #fff;
      box-shadow: 0 10px 24px rgba(31,41,55,0.18);
      pointer-events: none;
      opacity: 0;
      transform: translate(-50%, calc(-100% - 12px));
      transition: opacity 120ms ease;
    }
    .chart-tooltip.is-visible {
      opacity: 1;
    }
    .chart-tooltip-label {
      font-size: 11px;
      color: rgba(255,255,255,0.72);
    }
    .chart-tooltip-value {
      margin-top: 2px;
      font-size: 13px;
      font-weight: 600;
      white-space: nowrap;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      text-align: left;
      padding: 12px 14px;
      border-bottom: 1px solid var(--line);
      vertical-align: top;
      font-size: 14px;
    }
    th {
      color: var(--muted);
      font-weight: 600;
      background: rgba(38,70,83,0.04);
    }
    .empty {
      color: var(--muted);
      padding: 16px;
    }
    .error {
      color: var(--danger);
    }
    @media (max-width: 980px) {
      .summary-grid, .meta, .dimension-grid, .metric-list, .codex-grid {
        grid-template-columns: 1fr;
      }
      .codex-title-row { display: block; }
      .custom-range-group {
        width: 100%;
        margin-left: 0;
      }
    }
    @media (max-width: 640px) {
      .custom-range-group {
        flex-wrap: wrap;
      }
      .custom-range-group input {
        flex: 1 1 170px;
        min-width: 0;
      }
    }
  </style>
</head>
<body>
  <div class="page">
    <section class="hero">
      <div>
        <h1 data-i18n="ui.title">netcheck network dashboard</h1>
      </div>
      <div>
        <div class="language-switch" aria-label="Language">
          <button type="button" data-lang="en">EN</button>
          <button type="button" data-lang="zh-CN">中文</button>
        </div>
        <p id="generated-at"></p>
      </div>
    </section>

    <section class="toolbar">
      <strong data-i18n="ui.range">Time range</strong>
      <div class="preset-group">
        <button data-range="30m" data-i18n="ui.range.30m">Last 30 minutes</button>
        <button data-range="1h" data-i18n="ui.range.1h">Last 1 hour</button>
        <button data-range="6h" data-i18n="ui.range.6h">Last 6 hours</button>
        <button data-range="24h" data-i18n="ui.range.24h">Last 24 hours</button>
        <button data-range="7d" data-i18n="ui.range.7d">Last 7 days</button>
      </div>
      <div class="custom-range-group">
        <input id="start-input" type="datetime-local">
        <input id="end-input" type="datetime-local">
        <button id="apply-custom" data-i18n="ui.apply_custom">Apply custom range</button>
      </div>
    </section>

    <section class="summary-grid" id="summary-grid"></section>

    <section class="meta">
      <div class="panel">
        <h3 data-i18n="ui.incident_overview">Incident overview</h3>
        <div id="event-meta"></div>
      </div>
      <div class="panel">
        <h3 data-i18n="ui.link_incidents">Link incident totals</h3>
        <div id="cause-table"></div>
      </div>
    </section>

    <section id="group-container"></section>

    <section class="codex-section" id="codex-section"></section>

    <section class="panel">
      <h3 data-i18n="ui.event_timeline">Event timeline (latest 10)</h3>
      <div id="event-table"></div>
    </section>
  </div>

  <script>
    window.reportConfig = {
      liveMode: {{if .LiveMode}}true{{else}}false{{end}},
      initialPayload: {{.InitialJSON}},
      defaultRange: "{{.DefaultMode}}",
      initialLang: "{{.Lang}}",
      translations: {{.Translations}}
    };
  </script>
  <script>
    {{.CodexScript}}
  </script>
  <script>
    {{.ReportScript}}
  </script>
</body>
</html>
