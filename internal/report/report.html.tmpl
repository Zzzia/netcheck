<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>netcheck 网络质量面板</title>
  <style>
    :root {
      --bg: #f4f1ea;
      --card: #fffdf8;
      --ink: #1f2937;
      --muted: #6b7280;
      --line: #d9d3c7;
      --accent: #264653;
      --accent-soft: #dbe7ea;
      --danger: #d65d47;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at top right, rgba(231,111,81,0.18), transparent 20%),
        radial-gradient(circle at left top, rgba(38,70,83,0.12), transparent 25%),
        var(--bg);
    }
    .page {
      max-width: 1360px;
      margin: 0 auto;
      padding: 28px 20px 48px;
    }
    .hero {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      align-items: end;
      margin-bottom: 18px;
    }
    .hero h1 {
      margin: 0;
      font-size: 34px;
      letter-spacing: 0.02em;
    }
    .hero p {
      margin: 8px 0 0;
      color: var(--muted);
    }
    .toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      margin-bottom: 18px;
      padding: 14px;
      background: rgba(255,253,248,0.9);
      border: 1px solid rgba(0,0,0,0.05);
      border-radius: 18px;
      box-shadow: 0 12px 40px rgba(31,41,55,0.06);
    }
    .toolbar strong {
      margin-right: 4px;
    }
    .preset-group {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .toolbar button, .toolbar input {
      border: 1px solid rgba(38,70,83,0.18);
      border-radius: 10px;
      background: white;
      color: var(--ink);
      padding: 8px 12px;
      font: inherit;
    }
    .toolbar button {
      cursor: pointer;
    }
    .toolbar button.active {
      background: var(--accent);
      color: white;
      border-color: var(--accent);
    }
    .toolbar .muted {
      color: var(--muted);
      font-size: 13px;
    }
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      margin-bottom: 20px;
    }
    .card, .panel {
      background: var(--card);
      border: 1px solid rgba(0,0,0,0.05);
      border-radius: 18px;
      box-shadow: 0 12px 40px rgba(31,41,55,0.06);
    }
    .card {
      padding: 16px;
    }
    .card h2 {
      margin: 0 0 12px;
      font-size: 18px;
    }
    .metric-list { display: grid; grid-template-columns: repeat(var(--metric-columns, 3), minmax(0, 1fr)); gap: 10px 12px; }
    .metric-entry { min-width: 0; }
    .metric-label { color: var(--ink); font-size: 13px; font-weight: 600; margin-bottom: 6px; line-height: 1.25; }
    .metric-stack { display: grid; gap: 4px; min-width: 0; }
    .metric-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; min-width: 0; }
    .metric-value { font-size: 15px; font-weight: 700; min-width: 0; line-height: 1.2; }
    .metric-tag { display: inline-flex; align-items: center; padding: 2px 6px; border-radius: 999px; background: rgba(38,70,83,0.08); color: var(--muted); font-size: 10px; line-height: 1.2; white-space: nowrap; }
    .meta { display: grid; grid-template-columns: 220px 1fr; gap: 14px; margin-bottom: 20px; }
    .panel { padding: 16px; }
    .panel h3 { margin: 0 0 10px; font-size: 18px; }
    .dimension { margin-bottom: 20px; }
    .dimension h2 { margin: 0 0 10px; font-size: 20px; }
    .dimension-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
    .chart {
      position: relative;
      padding: 14px;
    }
    .chart-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 10px;
    }
    .chart-header h3 {
      margin: 0;
      font-size: 16px;
    }
    .chart-header span {
      font-size: 12px;
      color: var(--muted);
    }
    .chart svg {
      width: 100%;
      height: 220px;
      display: block;
      border-radius: 12px;
      background: linear-gradient(180deg, rgba(255,255,255,0.85), rgba(244,241,234,0.35));
    }
    .chart-tooltip {
      position: absolute;
      left: 0;
      top: 0;
      z-index: 2;
      min-width: 140px;
      padding: 8px 10px;
      border-radius: 10px;
      background: rgba(31,41,55,0.92);
      color: #fff;
      box-shadow: 0 10px 24px rgba(31,41,55,0.18);
      pointer-events: none;
      opacity: 0;
      transform: translate(-50%, calc(-100% - 12px));
      transition: opacity 120ms ease;
    }
    .chart-tooltip.is-visible {
      opacity: 1;
    }
    .chart-tooltip-label {
      font-size: 11px;
      color: rgba(255,255,255,0.72);
    }
    .chart-tooltip-value {
      margin-top: 2px;
      font-size: 13px;
      font-weight: 600;
      white-space: nowrap;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      text-align: left;
      padding: 12px 14px;
      border-bottom: 1px solid var(--line);
      vertical-align: top;
      font-size: 14px;
    }
    th {
      color: var(--muted);
      font-weight: 600;
      background: rgba(38,70,83,0.04);
    }
    .empty {
      color: var(--muted);
      padding: 16px;
    }
    .error {
      color: var(--danger);
    }
    @media (max-width: 980px) {
      .summary-grid, .meta, .dimension-grid, .metric-list {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="page">
    <section class="hero">
      <div>
        <h1>netcheck 网络质量面板</h1>
      </div>
      <div>
        <p id="generated-at"></p>
      </div>
    </section>

    <section class="toolbar">
      <strong>时间范围</strong>
      <div class="preset-group">
        <button data-range="30m">最近 30 分钟</button>
        <button data-range="1h">最近 1 小时</button>
        <button data-range="6h">最近 6 小时</button>
        <button data-range="24h">最近 24 小时</button>
        <button data-range="7d">最近 7 天</button>
      </div>
      <input id="start-input" type="datetime-local">
      <input id="end-input" type="datetime-local">
      <button id="apply-custom">应用自定义范围</button>
    </section>

    <section class="summary-grid" id="summary-grid"></section>

    <section class="meta">
      <div class="panel">
        <h3>异常概览</h3>
        <div id="event-meta"></div>
      </div>
      <div class="panel">
        <h3>链路异常统计</h3>
        <div id="cause-table"></div>
      </div>
    </section>

    <section id="group-container"></section>

    <section class="panel">
      <h3>事件时间轴（最近 10 条）</h3>
      <div id="event-table"></div>
    </section>
  </div>

  <script>
    window.reportConfig = {
      liveMode: {{if .LiveMode}}true{{else}}false{{end}},
      initialPayload: {{.InitialJSON}},
      defaultRange: "{{.DefaultMode}}"
    };
  </script>
  <script>
    {{.ReportScript}}
  </script>
</body>
</html>
